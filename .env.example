# ---- LLM（OpenAI 兼容接口）----
# 留空 api_key 时自动进入本地降级(mock)模式，项目仍可端到端跑通
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.4

# 示例：DeepSeek
# LLM_BASE_URL=https://api.deepseek.com/v1
# LLM_MODEL=deepseek-chat

# ---- 服务 ----
HOST=127.0.0.1
PORT=8000

# ---- 并发与重试 ----
WORKER_COUNT=3
MAX_RETRIES=2
RETRY_BACKOFF=2.0
