{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口的默认权限：允许执行随包分发的 resume-server sidecar",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "binaries/resume-server",
          "sidecar": true,
          "args": ["--port", "0"]
        }
      ]
    }
  ]
}
